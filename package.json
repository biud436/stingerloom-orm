{
  "name": "@stingerloom/orm",
  "version": "0.1.0",
  "description": "A standalone, framework-agnostic TypeScript ORM that can be used with any Node.js framework",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "author": "biud436 <biud436@gmail.com>",
  "license": "MIT",
  "keywords": [
    "orm",
    "typescript",
    "mysql",
    "postgresql",
    "postgres",
    "sqlite",
    "database",
    "decorator",
    "multi-tenancy",
    "typeorm-alternative",
    "stingerloom"
  ],
  "scripts": {
    "build": "rimraf dist && tsc",
    "prepublishOnly": "pnpm run build",
    "test": "jest"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "sql-template-tag": "^4.0.0",
    "typedi": "^0.10.0"
  },
  "peerDependencies": {
    "reflect-metadata": ">=0.1.0",
    "mysql2": "^3.0.0",
    "pg": "^8.0.0",
    "better-sqlite3": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "mysql2": { "optional": true },
    "pg": { "optional": true },
    "better-sqlite3": { "optional": true }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.4",
    "@types/node": "^20.4.8",
    "@types/pg": "^8.16.0",
    "better-sqlite3": "^12.6.2",
    "jest": "^29.6.4",
    "mysql2": "^3.9.3",
    "pg": "^8.18.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.1.1",
    "typescript": "^5.6.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/biud436/stingerloom-orm"
  },
  "bugs": {
    "url": "https://github.com/biud436/stingerloom-orm/issues"
  },
  "homepage": "https://github.com/biud436/stingerloom-orm#readme",
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
