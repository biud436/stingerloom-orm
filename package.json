{
  "name": "@stingerloom/orm",
  "version": "0.8.0",
  "description": "A standalone, framework-agnostic TypeScript ORM that can be used with any Node.js framework",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    },
    "./nestjs": {
      "types": "./dist/integration/nestjs/index.d.ts",
      "import": "./dist/esm/integration/nestjs/index.js",
      "require": "./dist/integration/nestjs/index.js"
    },
    "./prisma-import": {
      "types": "./dist/integration/prisma-import/index.d.ts",
      "import": "./dist/esm/integration/prisma-import/index.js",
      "require": "./dist/integration/prisma-import/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "nestjs": [
        "dist/integration/nestjs/index.d.ts"
      ],
      "prisma-import": [
        "dist/integration/prisma-import/index.d.ts"
      ]
    }
  },
  "bin": {
    "stingerloom": "dist/migration/cli-entry.js",
    "stingerloom-prisma-import": "dist/integration/prisma-import/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=16.0.0"
  },
  "author": "biud436 <biud436@gmail.com>",
  "license": "MIT",
  "keywords": [
    "orm",
    "typescript",
    "mysql",
    "postgresql",
    "postgres",
    "sqlite",
    "database",
    "decorator",
    "multi-tenancy",
    "stingerloom"
  ],
  "scripts": {
    "build": "rimraf dist && tsc && tsc -p tsconfig.esm.json",
    "prepublishOnly": "pnpm run build",
    "test": "jest",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "sql-template-tag": "^4.0.0",
    "typedi": "^0.10.0"
  },
  "peerDependencies": {
    "@mrleebo/prisma-ast": ">=0.12.0",
    "@nestjs/common": ">=8.0.0",
    "@nestjs/core": ">=8.0.0",
    "better-sqlite3": ">=9.0.0",
    "fast-glob": ">=3.0.0",
    "mysql2": "^3.0.0",
    "pg": "^8.0.0",
    "reflect-metadata": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "@mrleebo/prisma-ast": {
      "optional": true
    },
    "fast-glob": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mrleebo/prisma-ast": "^0.14.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.4",
    "@types/node": "^20.4.8",
    "@types/pg": "^8.16.0",
    "better-sqlite3": "^12.6.2",
    "fast-glob": "^3.3.3",
    "jest": "^29.6.4",
    "mysql2": "^3.9.3",
    "pg": "^8.18.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.2",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.1.1",
    "typescript": "^5.6.2",
    "vitepress": "^1.6.4",
    "zod": "^3.25.76"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/biud436/stingerloom-orm"
  },
  "bugs": {
    "url": "https://github.com/biud436/stingerloom-orm/issues"
  },
  "homepage": "https://github.com/biud436/stingerloom-orm#readme",
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
