NODE_ENV=development

# Database
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=linear_clone
DB_LOGGING=false
DB_SLOW_QUERY_MS=200

# Logging
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Schema sync
# - Allowed: true | false | safe | dry-run
# - In production this is forced to "false" by the env validation schema.
# - Default for dev is "safe" so first boot creates tables but never alters
#   them once they exist; pair with `pnpm migrate:run` for the change track.
# - Use "true" only on a local DB you don't mind getting reshaped on every
#   reload — it will drop/alter columns to match the entity layout.
ORM_SYNC=safe

# Auth
JWT_SECRET=dev-only-do-not-use-in-prod-must-be-32-chars
JWT_EXPIRES_IN=1h
# Mints JWTs for arbitrary user ids without a password — ONLY for dev/test.
AUTH_ALLOW_DEV_TOKEN=true

# Network
PORT=3000
CORS_ORIGINS=

# Throttling
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
