NODE_ENV=development

# Database
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=linear_clone
DB_LOGGING=false

# Schema sync
# - Allowed: true | false | safe | dry-run
# - In production this is forced to "false" by the env validation schema.
ORM_SYNC=true

# Auth
JWT_SECRET=dev-only-do-not-use-in-prod-must-be-32-chars
JWT_EXPIRES_IN=1h
# Mints JWTs for arbitrary user ids without a password — ONLY for dev/test.
AUTH_ALLOW_DEV_TOKEN=true

# Network
PORT=3000
CORS_ORIGINS=

# Throttling
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
