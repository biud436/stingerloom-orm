{
  "name": "nestjs-linear-clone",
  "version": "0.0.1",
  "description": "Linear-style issue tracker showcasing advanced Stingerloom ORM patterns: recursive CTEs, window functions, full-text search, JSON custom fields, FOR UPDATE SKIP LOCKED auto-assign, optimistic locking, and EntitySubscriber audit logging.",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "seed": "ts-node -r tsconfig-paths/register src/common/seed.cli.ts",
    "migrate:run": "stingerloom migrate:run --config stingerloom.config.ts",
    "migrate:rollback": "stingerloom migrate:rollback --config stingerloom.config.ts",
    "migrate:status": "stingerloom migrate:status --config stingerloom.config.ts",
    "migrate:generate": "stingerloom migrate:generate --config stingerloom.config.ts --output ./migrations",
    "migrate:baseline": "ts-node -r tsconfig-paths/register scripts/generate-baseline.ts",
    "test": "jest --config jest-e2e.json --forceExit --detectOpenHandles",
    "test:e2e": "jest --config jest-e2e.json --forceExit --detectOpenHandles",
    "test:stress": "STRESS=true jest --config jest-e2e.json --forceExit --detectOpenHandles --testPathPattern=stress",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^5.2.0",
    "@stingerloom/orm": "workspace:*",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.5",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "mysql2": "^3.9.3",
    "nestjs-pino": "^4.1.0",
    "pg": "^8.11.3",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.2.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sql-template-tag": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.4.22",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "jest": "^30.2.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  }
}
